on early-init
    # Apply strict SELinux checking of PROT_EXEC on mmap/mprotect calls.
    write /sys/fs/selinux/checkreqprot 0

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1

    # Crypto / metadata
    export ANDROID_ROOT /system
    export ANDROID_DATA /data
    export EXTERNAL_STORAGE /sdcard

on fs
    wait /dev/block/by-name/userdata

    # Mount metadata partition (required for FBE)
    mkdir /metadata 0771 system system
    mount ext4 /dev/block/by-name/md_udc /metadata noatime discard

    # Protect partitions
    mkdir /mnt/vendor/protect_f 0771 system system
    mkdir /mnt/vendor/protect_s 0771 system system

on fs && property:ro.debuggable=1
    # Start ADB when the device is a debug build
    start adbd

on post-fs
    # Support A/B feature for eMMC boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b

    # Run MTK platform path utils for dynamic partitions
    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils

on post-fs-data
    mkdir /data/vendor_de 0771 system system
    mkdir /data/vendor_de/0 0771 system system

on boot
    # Ensure USB works in recovery
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 0e8d
    write /sys/class/android_usb/android0/idProduct 201c
    write /sys/class/android_usb/android0/f_acm/acm_transports tty
    write /sys/class/android_usb/android0/enable 1

    # Distinguish USB: CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2

on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring

on property:twrp.all.users.decrypted=true
    setprop sys.usb.config mtp,adb
    setprop sys.usb.state mtp,adb

# keystore is not started in recovery; keystore_auth is enough for FBE
service keystore_auth /system/bin/keystore_auth
    oneshot
    user system
    group root
    disabled
    seclabel u:r:recovery:s0
